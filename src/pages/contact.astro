---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';
import { useTranslations } from '~/i18n/translations';

const locale = Astro.currentLocale || 'en';
const { t } = useTranslations(locale);

const metadata = {
  title: `${t('contact.tagline')} — SecureHive`,
  description: t('contact.subtitle'),
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline={t('contact.tagline')}
    title={t('contact.title')}
    subtitle={t('contact.subtitle')}
  />

  <ContactUs
    id="form"
    title={t('contact.formTitle')}
    subtitle={t('contact.formSubtitle')}
    inputs={[
      { type: 'text', name: 'name', label: t('contact.nameLabel'), required: true },
      { type: 'email', name: 'email', label: t('contact.emailLabel'), required: true },
      { type: 'text', name: 'company', label: t('contact.companyLabel') },
      { type: 'tel', name: 'phone', label: t('contact.phoneLabel') },
    ]}
    textarea={{
      label: t('contact.messageLabel'),
    }}
    disclaimer={{
      label: t('contact.disclaimer'),
    }}
    description={t('contact.responseNote')}
    button={t('contact.submitBtn')}
  />

  <Features2
    title={t('contact.engageTitle')}
    items={[
      {
        title: t('contact.engage1Title'),
        description: t('contact.engage1Desc'),
        icon: 'tabler:presentation',
      },
      {
        title: t('contact.engage2Title'),
        description: t('contact.engage2Desc'),
        icon: 'tabler:briefcase',
      },
      {
        title: t('contact.engage3Title'),
        description: t('contact.engage3Desc'),
        icon: 'tabler:headset',
      },
    ]}
  />
</Layout>
