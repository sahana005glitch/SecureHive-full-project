---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Steps from '~/components/widgets/Steps.astro';
import { getMarketingContent, useTranslations } from '~/i18n/translations';
import { getLocalizedPath } from '~/i18n/routes';

const locale = Astro.currentLocale || 'en';
const { t } = useTranslations(locale);
const workflow = getMarketingContent(locale).products.items.pam.workflow;
const localePath = (p: string) => getLocalizedPath(p, locale);

const metadata = {
  title: `${t('products.items.pam.title')} — SecureHive`,
  description: t('products.items.pam.subtitle'),
};
---

<Layout metadata={metadata}>
  <Hero
    tagline={t('products.items.pam.tagline')}
    actions={[
      { variant: 'primary', text: t('common.requestDemo'), href: localePath('/contact') },
      { text: t('common.allProducts'), href: localePath('/products') },
    ]}
  >
    <Fragment slot="title">{t('products.items.pam.title')}</Fragment>
    <Fragment slot="subtitle">{t('products.items.pam.subtitle')}</Fragment>
  </Hero>

  <Features
    title={t('products.items.pam.featuresTitle')}
    items={[
      {
        title: t('products.items.pam.feat1Title'),
        description: t('products.items.pam.feat1Desc'),
        icon: 'tabler:search',
      },
      {
        title: t('products.items.pam.feat2Title'),
        description: t('products.items.pam.feat2Desc'),
        icon: 'tabler:refresh',
      },
      {
        title: t('products.items.pam.feat3Title'),
        description: t('products.items.pam.feat3Desc'),
        icon: 'tabler:lock',
      },
      {
        title: t('products.items.pam.feat4Title'),
        description: t('products.items.pam.feat4Desc'),
        icon: 'tabler:file-text',
      },
      {
        title: t('products.items.pam.feat5Title'),
        description: t('products.items.pam.feat5Desc'),
        icon: 'tabler:link',
      },
      {
        title: t('products.items.pam.feat6Title'),
        description: t('products.items.pam.feat6Desc'),
        icon: 'tabler:code',
      },
    ]}
  />

  <Steps title={workflow.title} items={workflow.steps} />

  <FAQs
    title={t('products.faqsTitle')}
    items={[
      { title: t('products.faq1Q'), description: t('products.faq1A') },
      { title: t('products.faq2Q'), description: t('products.faq2A') },
      { title: t('products.faq3Q'), description: t('products.faq3A') },
    ]}
  />

  <CallToAction actions={[{ variant: 'primary', text: t('common.requestDemo'), href: localePath('/contact') }]}>
    <Fragment slot="title">{t('products.items.pam.ctaTitle')}</Fragment>
    <Fragment slot="subtitle">{t('products.items.pam.ctaSubtitle')}</Fragment>
  </CallToAction>
</Layout>
