---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Service Account & Secrets Security',
  description: 'Discover, vault, and rotate non-human identities — service accounts, DevOps secrets, and machine credentials.',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Product"
    actions={[
      { variant: 'primary', text: 'Request a Demo', href: '/contact' },
      { text: 'All Products', href: '/products' },
    ]}
  >
    <Fragment slot="title">Service Account & Secrets Security</Fragment>
    <Fragment slot="subtitle">
      Non-human identities often outnumber people — and outlive projects. Discover service accounts and secrets,
      vault them, rotate them, and stop hardcoding credentials in scripts and pipelines.
    </Fragment>
  </Hero>

  <Features
    title="Non-human identity controls"
    items={[
      { title: 'Service account discovery', description: 'Find Windows, domain, and application service accounts that hold privileged rights.', icon: 'tabler:robot' },
      { title: 'DevOps secrets hygiene', description: 'Reduce secrets in CI/CD and config by centralizing retrieval and rotation.', icon: 'tabler:code' },
      { title: 'Dependency-aware rotation', description: 'Update dependent services when passwords change so automation does not break.', icon: 'tabler:git-branch' },
      { title: 'Ownership & accountability', description: 'Assign owners to machine identities so orphaned accounts get reviewed or retired.', icon: 'tabler:user-check' },
      { title: 'API access patterns', description: 'Allow approved workloads to fetch secrets at runtime instead of embedding them.', icon: 'tabler:api' },
      { title: 'Risk reporting', description: 'Highlight stale, over-privileged, or unused machine accounts for remediation.', icon: 'tabler:alert-triangle' },
    ]}
  />

  <FAQs
    title="Frequently asked questions"
    items={[
      { title: 'Why are service accounts a PAM problem?', description: 'They often have high privilege, shared knowledge, and weak rotation. Attackers target them because they are less monitored than human admins.' },
      { title: 'Can we manage cloud workload identities?', description: 'Capability depends on your connectors and architecture. The product focus is privileged and operational secrets across hybrid environments.' },
      { title: 'How do we onboard without breaking production?', description: 'Discovery-first onboarding, staged rotation, and dependency mapping reduce the risk of disruptive password changes.' },
      { title: 'Does this replace a dedicated secrets manager?', description: 'Teams often use SecureHive alongside or as the control point for privileged and operational secrets. Fit depends on your stack.' },
    ]}
  />

  <CallToAction actions={[{ variant: 'primary', text: 'Request a Demo', href: '/contact' }]}>
    <Fragment slot="title">Secure non-human privileged access</Fragment>
    <Fragment slot="subtitle">Review discovery and rotation approaches for service accounts and secrets.</Fragment>
  </CallToAction>
</Layout>
