---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { useTranslations } from '~/i18n/translations';
import { getLocalizedPath } from '~/i18n/routes';

const locale = Astro.currentLocale || 'en';
const { t } = useTranslations(locale);
const localePath = (p: string) => getLocalizedPath(p, locale);

const metadata = {
  title: `${t('products.items.session.title')} — SecureHive`,
  description: t('products.items.session.subtitle'),
};
---

<Layout metadata={metadata}>
  <Hero
    tagline={t('products.items.session.tagline')}
    actions={[
      { variant: 'primary', text: t('common.requestDemo'), href: localePath('/contact') },
      { text: t('common.allProducts'), href: localePath('/products') },
    ]}
  >
    <Fragment slot="title">{t('products.items.session.title')}</Fragment>
    <Fragment slot="subtitle">{t('products.items.session.subtitle')}</Fragment>
  </Hero>

  <Features
    title={t('products.items.session.featuresTitle')}
    items={[
      { title: t('products.items.session.feat1Title'), description: t('products.items.session.feat1Desc'), icon: 'tabler:key' },
      { title: t('products.items.session.feat2Title'), description: t('products.items.session.feat2Desc'), icon: 'tabler:eye' },
      { title: t('products.items.session.feat3Title'), description: t('products.items.session.feat3Desc'), icon: 'tabler:video' },
      { title: t('products.items.session.feat4Title'), description: t('products.items.session.feat4Desc'), icon: 'tabler:player-stop' },
      { title: t('products.items.session.feat5Title'), description: t('products.items.session.feat5Desc'), icon: 'tabler:network' },
      { title: t('products.items.session.feat6Title'), description: t('products.items.session.feat6Desc'), icon: 'tabler:search' },
    ]}
  />

  <FAQs
    title={t('products.faqsTitle')}
    items={[
      { title: t('products.faq1Q'), description: t('products.faq1A') },
      { title: t('products.faq2Q'), description: t('products.faq2A') },
      { title: t('products.faq3Q'), description: t('products.faq3A') },
    ]}
  />

  <CallToAction actions={[{ variant: 'primary', text: t('common.requestDemo'), href: localePath('/contact') }]}>
    <Fragment slot="title">{t('products.items.session.ctaTitle')}</Fragment>
    <Fragment slot="subtitle">{t('products.items.session.ctaSubtitle')}</Fragment>
  </CallToAction>
</Layout>
