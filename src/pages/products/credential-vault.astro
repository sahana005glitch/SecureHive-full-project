---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Credential Vault',
  description: 'Enterprise credential vault for privileged passwords, keys, and secrets with policy-based access.',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Product"
    actions={[
      { variant: 'primary', text: 'Request a Demo', href: '/contact' },
      { text: 'All Products', href: '/products' },
    ]}
  >
    <Fragment slot="title">Credential Vault</Fragment>
    <Fragment slot="subtitle">
      A hardened vault for privileged passwords, keys, and operational secrets — with encryption, access policies,
      and complete checkout history.
    </Fragment>
  </Hero>

  <Features
    title="Vault capabilities"
    items={[
      { title: 'Strong encryption', description: 'Protect credentials at rest and in transit with enterprise-grade encryption practices.', icon: 'tabler:lock' },
      { title: 'Granular permissions', description: 'Share view, connect, or manage rights based on role and need — defaulting to least privilege.', icon: 'tabler:shield' },
      { title: 'Checkout controls', description: 'Require reasons, dual approval, or time limits before sensitive credentials are released.', icon: 'tabler:clipboard-check' },
      { title: 'Rotation policies', description: 'Automate password changes on a schedule or after use to shrink credential lifetime.', icon: 'tabler:refresh' },
      { title: 'API & automation', description: 'Allow approved automation and pipelines to retrieve secrets without hardcoding them.', icon: 'tabler:code' },
      { title: 'Compliance reports', description: 'Demonstrate who accessed which secrets and when for audits and assessments.', icon: 'tabler:report' },
    ]}
  />

  <FAQs
    title="Frequently asked questions"
    items={[
      { title: 'Is this only for human passwords?', description: 'No. The vault is designed for human privileged accounts, service accounts, and operational secrets used by applications and scripts.' },
      { title: 'How do we avoid secret sprawl in code?', description: 'Applications and automation can retrieve secrets through controlled interfaces instead of storing them in config files or repositories.' },
      { title: 'Can we enforce dual control?', description: 'Yes. High-risk credentials can require multiple approvers before checkout or modification.' },
      { title: 'What about break-glass accounts?', description: 'Emergency accounts can be vaulted with stricter logging and post-access review while remaining available when needed.' },
    ]}
  />

  <CallToAction actions={[{ variant: 'primary', text: 'Request a Demo', href: '/contact' }]}>
    <Fragment slot="title">Centralize privileged credentials</Fragment>
    <Fragment slot="subtitle">Review vault policies, checkout flows, and rotation with our team.</Fragment>
  </CallToAction>
</Layout>
