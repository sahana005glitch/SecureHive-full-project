---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { useTranslations } from '~/i18n/translations';
import { getLocalizedPath } from '~/i18n/routes';

const locale = Astro.currentLocale || 'en';
const { t } = useTranslations(locale);
const localePath = (p: string) => getLocalizedPath(p, locale);

const metadata = {
  title: `${t('products.items.vault.title')} — SecureHive`,
  description: t('products.items.vault.subtitle'),
};
---

<Layout metadata={metadata}>
  <Hero
    tagline={t('products.items.vault.tagline')}
    actions={[
      { variant: 'primary', text: t('common.requestDemo'), href: localePath('/contact') },
      { text: t('common.allProducts'), href: localePath('/products') },
    ]}
  >
    <Fragment slot="title">{t('products.items.vault.title')}</Fragment>
    <Fragment slot="subtitle">{t('products.items.vault.subtitle')}</Fragment>
  </Hero>

  <Features
    title={t('products.items.vault.featuresTitle')}
    items={[
      { title: t('products.items.vault.feat1Title'), description: t('products.items.vault.feat1Desc'), icon: 'tabler:lock' },
      { title: t('products.items.vault.feat2Title'), description: t('products.items.vault.feat2Desc'), icon: 'tabler:shield' },
      { title: t('products.items.vault.feat3Title'), description: t('products.items.vault.feat3Desc'), icon: 'tabler:clipboard-check' },
      { title: t('products.items.vault.feat4Title'), description: t('products.items.vault.feat4Desc'), icon: 'tabler:refresh' },
      { title: t('products.items.vault.feat5Title'), description: t('products.items.vault.feat5Desc'), icon: 'tabler:code' },
      { title: t('products.items.vault.feat6Title'), description: t('products.items.vault.feat6Desc'), icon: 'tabler:report' },
    ]}
  />

  <FAQs
    title={t('products.faqsTitle')}
    items={[
      { title: t('products.faq1Q'), description: t('products.faq1A') },
      { title: t('products.faq2Q'), description: t('products.faq2A') },
      { title: t('products.faq3Q'), description: t('products.faq3A') },
    ]}
  />

  <CallToAction actions={[{ variant: 'primary', text: t('common.requestDemo'), href: localePath('/contact') }]}>
    <Fragment slot="title">{t('products.items.vault.ctaTitle')}</Fragment>
    <Fragment slot="subtitle">{t('products.items.vault.ctaSubtitle')}</Fragment>
  </CallToAction>
</Layout>
