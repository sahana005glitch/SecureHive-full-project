---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import { useTranslations } from '~/i18n/translations';
import { getLocalizedPath } from '~/i18n/routes';

const locale = Astro.currentLocale || 'en';
const { t } = useTranslations(locale);
const localePath = (p: string) => getLocalizedPath(p, locale);

const metadata = {
  title: `${t('pricing.tagline')} — SecureHive`,
  description: t('pricing.subtitle'),
};
---

<Layout metadata={metadata}>
  <HeroText tagline={t('pricing.tagline')} title={t('pricing.title')} subtitle={t('pricing.subtitle')} />

  <section class="py-16 md:py-20 bg-white dark:bg-section">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <div class="rounded-2xl border border-slate-200 dark:border-theme bg-page dark:bg-card-surface p-10 md:p-14">
        <h2 class="text-2xl font-bold text-primary dark:text-heading mb-4">{t('pricing.planTitle')}</h2>
        <p class="text-slate-600 dark:text-default mb-8 leading-relaxed">
          {t('pricing.planDesc')}
        </p>
        <a
          href={localePath('/contact')}
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-lg bg-primary text-white font-semibold hover:bg-secondary transition-all duration-200 dark:text-[#081426]"
        >
          {t('common.contactSales')}
          <svg class="w-4 h-4 sh-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <FAQs
    title={t('pricing.faqsTitle')}
    items={[
      {
        title: t('pricing.faq1Q'),
        description: t('pricing.faq1A'),
      },
      {
        title: t('pricing.faq2Q'),
        description: t('pricing.faq2A'),
      },
      {
        title: t('pricing.faq3Q'),
        description: t('pricing.faq3A'),
      },
    ]}
  />

  <CallToAction
    actions={[
      { variant: 'primary', text: t('common.contactSales'), href: localePath('/contact') },
      { text: t('common.exploreSolutions'), href: localePath('/solutions') },
    ]}
  >
    <Fragment slot="title">{t('pricing.ctaTitle')}</Fragment>
    <Fragment slot="subtitle">{t('pricing.ctaSubtitle')}</Fragment>
  </CallToAction>
</Layout>
