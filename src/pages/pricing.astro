---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import FAQs from '~/components/widgets/FAQs.astro';

const metadata = {
  title: 'Pricing',
  description: 'SecureHive enterprise pricing — contact us for a tailored proposal.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Pricing"
    title="Enterprise pricing tailored to your environment"
    subtitle="SecureHive is licensed for enterprise deployments. Pricing depends on scope, integrations, and support requirements."
  />

  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <div class="rounded-2xl border border-slate-200 bg-[#F8FAFC] p-10 md:p-14">
        <h2 class="text-2xl font-bold text-[#0B2D5B] mb-4">Custom enterprise plans</h2>
        <p class="text-slate-600 mb-8 leading-relaxed">
          We work with security and procurement teams to define the right combination of identity, access,
          endpoint, and cloud capabilities. Contact us for a proposal based on your environment.
        </p>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-lg bg-[#3B82F6] text-white font-semibold hover:bg-blue-500 transition-all duration-200"
        >
          Contact Sales
          <svg class="w-4 h-4 sh-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <FAQs
    title="Common questions"
    items={[
      {
        title: 'How is SecureHive licensed?',
        description:
          'Licensing is typically based on the scope of deployment and selected product areas. Our team will recommend a structure that matches your environment.',
      },
      {
        title: 'Can we start with a pilot?',
        description:
          'Yes. Many organizations begin with a focused pilot around identity or privileged access before expanding.',
      },
      {
        title: 'Do you offer professional services?',
        description:
          'Implementation and advisory services can be included as part of an enterprise engagement. Details are provided during the proposal process.',
      },
    ]}
  />

  <CallToAction
    actions={[{ variant: 'primary', text: 'Request a Demo', href: '/contact' }]}
  >
    <Fragment slot="title">Ready to discuss your requirements?</Fragment>
    <Fragment slot="subtitle">Our team will help you evaluate fit and next steps.</Fragment>
  </CallToAction>
</Layout>
