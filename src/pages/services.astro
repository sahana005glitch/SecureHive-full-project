---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { useTranslations } from '~/i18n/translations';
import { getLocalizedPath } from '~/i18n/routes';

const locale = Astro.currentLocale || 'en';
const { t } = useTranslations(locale);
const localePath = (p: string) => getLocalizedPath(p, locale);

const metadata = {
  title: `${t('services.titleMain')} — SecureHive`,
  description: t('services.subtitle'),
};
---

<Layout metadata={metadata}>
  <Hero
    tagline={t('services.tagline')}
    actions={[
      { variant: 'primary', text: t('common.requestDemo'), href: localePath('/contact') },
      { text: t('common.contactUs'), href: localePath('/contact') },
    ]}
  >
    <Fragment slot="title">
      {t('services.titleMain')}<br />
      <span class="text-accent">{t('services.titleAccent')}</span>
    </Fragment>
    <Fragment slot="subtitle">
      {t('services.subtitle')}
    </Fragment>
  </Hero>

  <Features
    id="solutions"
    tagline={t('services.capTagline')}
    title={t('services.capTitle')}
    subtitle={t('services.capSubtitle')}
    items={[
      {
        title: t('home.solIdentityTitle'),
        description: t('home.solIdentityDesc'),
        icon: 'tabler:user-check',
      },
      {
        title: t('home.solPamTitle'),
        description: t('home.solPamDesc'),
        icon: 'tabler:key',
      },
      {
        title: t('home.solEndpointTitle'),
        description: t('home.solEndpointDesc'),
        icon: 'tabler:device-desktop',
      },
      {
        title: t('home.solCloudTitle'),
        description: t('home.solCloudDesc'),
        icon: 'tabler:cloud',
      },
      {
        title: t('home.solAutomationTitle'),
        description: t('home.solAutomationDesc'),
        icon: 'tabler:bolt',
      },
      {
        title: t('home.solVisibilityTitle'),
        description: t('home.solVisibilityDesc'),
        icon: 'tabler:chart-dots',
      },
    ]}
  />

  <Features2
    title={t('nav.products')}
    subtitle={t('products.subtitle')}
    items={[
      {
        title: t('products.items.pam.title'),
        description: t('products.items.pam.desc'),
        icon: 'tabler:lock',
      },
      {
        title: t('products.items.jit.title'),
        description: t('products.items.jit.desc'),
        icon: 'tabler:clock',
      },
      {
        title: t('products.items.session.title'),
        description: t('products.items.session.desc'),
        icon: 'tabler:video',
      },
      {
        title: t('products.items.vault.title'),
        description: t('products.items.vault.desc'),
        icon: 'tabler:lock',
      },
    ]}
  />

  <CallToAction
    actions={[
      { variant: 'primary', text: t('common.requestDemo'), href: localePath('/contact') },
    ]}
  >
    <Fragment slot="title">{t('services.ctaTitle')}</Fragment>
    <Fragment slot="subtitle">
      {t('services.ctaSubtitle')}
    </Fragment>
  </CallToAction>
</Layout>
