---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { useTranslations } from '~/i18n/translations';
import { getLocalizedPath } from '~/i18n/routes';

const locale = Astro.currentLocale || 'en';
const { t } = useTranslations(locale);
const localePath = (p: string) => getLocalizedPath(p, locale);

const metadata = {
  title: `${t('products.tagline')} — SecureHive`,
  description: t('products.subtitle'),
};

const productList = [
  { key: 'pam', href: '/products/privileged-account-manager', icon: 'tabler:lock' },
  { key: 'jit', href: '/products/just-in-time-access', icon: 'tabler:clock' },
  { key: 'session', href: '/products/session-manager', icon: 'tabler:video' },
  { key: 'vault', href: '/products/credential-vault', icon: 'tabler:safe' },
  { key: 'epm', href: '/products/endpoint-privilege-manager', icon: 'tabler:device-desktop' },
  { key: 'serviceAccount', href: '/products/service-account-security', icon: 'tabler:robot' },
] as const;
---

<Layout metadata={metadata}>
  <Hero
    tagline={t('products.tagline')}
    actions={[
      { variant: 'primary', text: t('common.requestDemo'), href: localePath('/contact') },
      { text: t('common.exploreSolutions'), href: localePath('/solutions') },
    ]}
  >
    <Fragment slot="title">
      {t('products.titleMain')}<br />
      <span class="text-accent">{t('products.titleAccent')}</span>
    </Fragment>
    <Fragment slot="subtitle">
      {t('products.subtitle')}
    </Fragment>
  </Hero>

  <section class="py-16 md:py-20 bg-white dark:bg-section">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          productList.map((p) => (
            <a
              href={localePath(p.href)}
              class="sh-card group block p-6 rounded-xl border border-slate-200 dark:border-theme bg-page dark:bg-card-surface hover:border-accent/60 dark:hover:border-primary transition-all"
            >
              <h3 class="text-lg font-semibold text-primary dark:text-heading mb-2 group-hover:text-brand-warm transition-colors">
                {t(`products.items.${p.key}.title`)}
              </h3>
              <p class="text-sm text-slate-600 dark:text-muted leading-relaxed mb-4">
                {t(`products.items.${p.key}.desc`)}
              </p>
              <span class="text-sm font-medium text-brand-warm inline-flex items-center gap-1">
                {t('common.learnMore')}
                <svg class="w-4 h-4 sh-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <FAQs
    title={t('products.faqsTitle')}
    items={[
      { title: t('products.faq1Q'), description: t('products.faq1A') },
      { title: t('products.faq2Q'), description: t('products.faq2A') },
      { title: t('products.faq3Q'), description: t('products.faq3A') },
    ]}
  />

  <CallToAction actions={[{ variant: 'primary', text: t('common.requestDemo'), href: localePath('/contact') }]}>
    <Fragment slot="title">{t('products.ctaTitle')}</Fragment>
    <Fragment slot="subtitle">{t('products.ctaSubtitle')}</Fragment>
  </CallToAction>
</Layout>
