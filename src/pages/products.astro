---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Products — Privileged Access Management',
  description:
    'SecureHive PAM products: privileged account manager, just-in-time access, session manager, credential vault, endpoint privilege, and service account security.',
};

const products = [
  { title: 'Privileged Account Manager', href: '/products/privileged-account-manager', description: 'Discover, vault, and control privileged accounts with automated rotation and full audit trails.', icon: 'tabler:lock' },
  { title: 'Just-in-Time Access', href: '/products/just-in-time-access', description: 'Replace standing privilege with request-based, time-limited elevated access.', icon: 'tabler:clock' },
  { title: 'Session Manager', href: '/products/session-manager', description: 'Launch, monitor, and record privileged sessions without exposing credentials.', icon: 'tabler:video' },
  { title: 'Credential Vault', href: '/products/credential-vault', description: 'Enterprise vault for privileged passwords, keys, and operational secrets.', icon: 'tabler:safe' },
  { title: 'Endpoint Privilege Manager', href: '/products/endpoint-privilege-manager', description: 'Remove local admin rights and elevate applications only when policy allows.', icon: 'tabler:device-desktop' },
  { title: 'Service Account Security', href: '/products/service-account-security', description: 'Discover, vault, and rotate non-human identities and DevOps secrets.', icon: 'tabler:robot' },
];
---

<Layout metadata={metadata}>
  <Hero
    tagline="Products"
    actions={[
      { variant: 'primary', text: 'Request a Demo', href: '/contact' },
      { text: 'Explore Solutions', href: '/solutions' },
    ]}
  >
    <Fragment slot="title">
      Privileged Access Management<br />
      <span class="text-accent">product suite</span>
    </Fragment>
    <Fragment slot="subtitle">
      Six integrated capabilities to discover privileged accounts, enforce just-in-time access, vault credentials,
      and monitor sessions across the enterprise.
    </Fragment>
  </Hero>

  <section class="py-16 md:py-20 bg-white dark:bg-transparent">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {products.map((p) => (
          <a
            href={p.href}
            class="sh-card group block p-6 rounded-xl border border-slate-200 dark:border-slate-700 bg-[#F8FAFC] dark:bg-slate-900/50 hover:border-blue-300 dark:hover:border-blue-600 transition-all"
          >
            <h3 class="text-lg font-semibold text-[#0B2D5B] dark:text-white mb-2 group-hover:text-[#3B82F6] transition-colors">
              {p.title}
            </h3>
            <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-4">{p.description}</p>
            <span class="text-sm font-medium text-[#3B82F6] inline-flex items-center gap-1">
              Learn more
              <svg class="w-4 h-4 sh-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <FAQs
    title="Product FAQs"
    items={[
      { title: 'Do we need every product?', description: 'No. Many teams start with Privileged Account Manager and Credential Vault, then add JIT and Session Manager as the program matures.' },
      { title: 'How does this differ from IAM?', description: 'IAM manages workforce identity and SSO. SecureHive governs elevated access to critical systems and secrets after authentication.' },
      { title: 'Can we deploy in phases?', description: 'Yes. Discovery and vaulting of shared admins is a common first phase, followed by JIT and session controls.' },
      { title: 'Is there a cloud-only requirement?', description: 'SecureHive is designed for hybrid enterprise environments. Deployment options are discussed during evaluation.' },
    ]}
  />

  <CallToAction actions={[{ variant: 'primary', text: 'Request a Demo', href: '/contact' }]}>
    <Fragment slot="title">See the suite in your context</Fragment>
    <Fragment slot="subtitle">We will map products to your privileged access risks and roadmap.</Fragment>
  </CallToAction>
</Layout>
