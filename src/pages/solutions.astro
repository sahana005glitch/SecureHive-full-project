---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { useTranslations } from '~/i18n/translations';
import { getLocalizedPath } from '~/i18n/routes';

const locale = Astro.currentLocale || 'en';
const { t } = useTranslations(locale);
const localePath = (p: string) => getLocalizedPath(p, locale);

const metadata = {
  title: `${t('solutions.tagline')} — SecureHive`,
  description: t('solutions.subtitle'),
};

const solutionList = [
  { key: 'financial', href: '/solutions/financial-services' },
  { key: 'healthcare', href: '/solutions/healthcare' },
  { key: 'mfg', href: '/solutions/manufacturing' },
  { key: 'gov', href: '/solutions/government' },
  { key: 'enterpriseIt', href: '/solutions/enterprise-it' },
  { key: 'vendor', href: '/solutions/vendor-access' },
] as const;
---

<Layout metadata={metadata}>
  <Hero
    tagline={t('solutions.tagline')}
    actions={[
      { variant: 'primary', text: t('common.requestDemo'), href: localePath('/contact') },
      { text: t('common.viewProducts'), href: localePath('/products') },
    ]}
  >
    <Fragment slot="title">
      {t('solutions.titleMain')}<br />
      <span class="text-accent">{t('solutions.titleAccent')}</span>
    </Fragment>
    <Fragment slot="subtitle">
      {t('solutions.subtitle')}
    </Fragment>
  </Hero>

  <section class="py-16 md:py-20 bg-white dark:bg-section">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          solutionList.map((s) => (
            <a
              href={localePath(s.href)}
              class="sh-card group block p-6 rounded-xl border border-slate-200 dark:border-theme bg-page dark:bg-card-surface hover:border-accent/60 dark:hover:border-primary transition-all"
            >
              <h3 class="text-lg font-semibold text-primary dark:text-heading mb-2 group-hover:text-brand-warm transition-colors">
                {t(`solutions.items.${s.key}.title`)}
              </h3>
              <p class="text-sm text-slate-600 dark:text-muted leading-relaxed mb-4">
                {t(`solutions.items.${s.key}.desc`)}
              </p>
              <span class="text-sm font-medium text-brand-warm inline-flex items-center gap-1">
                {t('common.explore')}
                <svg class="w-4 h-4 sh-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <FAQs
    title={t('solutions.faqsTitle')}
    items={[
      { title: t('solutions.faq1Q'), description: t('solutions.faq1A') },
      { title: t('solutions.faq2Q'), description: t('solutions.faq2A') },
      { title: t('solutions.faq3Q'), description: t('solutions.faq3A') },
      { title: t('solutions.faq4Q'), description: t('solutions.faq4A') },
    ]}
  />

  <CallToAction actions={[{ variant: 'primary', text: t('common.requestDemo'), href: localePath('/contact') }]}>
    <Fragment slot="title">{t('solutions.ctaTitle')}</Fragment>
    <Fragment slot="subtitle">{t('solutions.ctaSubtitle')}</Fragment>
  </CallToAction>
</Layout>
