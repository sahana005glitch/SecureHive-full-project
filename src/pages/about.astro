---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { useTranslations } from '~/i18n/translations';
import { getLocalizedPath } from '~/i18n/routes';

const locale = Astro.currentLocale || 'en';
const { t } = useTranslations(locale);
const localePath = (p: string) => getLocalizedPath(p, locale);

const metadata = {
  title: `${t('about.titleMain')} — SecureHive`,
  description: t('about.subtitle'),
};
---

<Layout metadata={metadata}>
  <Hero
    tagline={t('about.tagline')}
    actions={[
      { variant: 'primary', text: t('common.contactUs'), href: localePath('/contact') },
      { text: t('common.requestDemo'), href: localePath('/contact') },
    ]}
  >
    <Fragment slot="title">
      {t('about.titleMain')}<br />
      <span class="text-accent">{t('about.titleAccent')}</span>
    </Fragment>
    <Fragment slot="subtitle">
      {t('about.subtitle')}
    </Fragment>
  </Hero>

  <Features2
    title={t('about.featuresTitle')}
    items={[
      {
        title: t('about.feature1Title'),
        description: t('about.feature1Desc'),
        icon: 'tabler:user-shield',
      },
      {
        title: t('about.feature2Title'),
        description: t('about.feature2Desc'),
        icon: 'tabler:eye',
      },
      {
        title: t('about.feature3Title'),
        description: t('about.feature3Desc'),
        icon: 'tabler:building',
      },
      {
        title: t('about.feature4Title'),
        description: t('about.feature4Desc'),
        icon: 'tabler:shield-check',
      },
    ]}
  />

  <CallToAction
    actions={[
      { variant: 'primary', text: t('common.requestDemo'), href: localePath('/contact') },
      { text: t('common.viewProducts'), href: localePath('/products') },
    ]}
  >
    <Fragment slot="title">{t('about.ctaTitle')}</Fragment>
    <Fragment slot="subtitle">
      {t('about.ctaSubtitle')}
    </Fragment>
  </CallToAction>
</Layout>
