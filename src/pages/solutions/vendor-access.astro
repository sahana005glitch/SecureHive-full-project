---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { useTranslations } from '~/i18n/translations';
import { getLocalizedPath } from '~/i18n/routes';

const locale = Astro.currentLocale || 'en';
const { t } = useTranslations(locale);
const localePath = (p: string) => getLocalizedPath(p, locale);

const metadata = {
  title: `${t('solutions.items.vendor.title')} — SecureHive`,
  description: t('solutions.items.vendor.subtitle'),
};
---

<Layout metadata={metadata}>
  <Hero
    tagline={t('solutions.tagline')}
    actions={[
      { variant: 'primary', text: t('common.requestDemo'), href: localePath('/contact') },
      { text: t('common.allSolutions'), href: localePath('/solutions') },
    ]}
  >
    <Fragment slot="title">{t('solutions.items.vendor.title')}</Fragment>
    <Fragment slot="subtitle">{t('solutions.items.vendor.subtitle')}</Fragment>
  </Hero>

  <Features
    title={t('solutions.items.vendor.featuresTitle')}
    items={[
      { title: t('solutions.items.vendor.feat1Title'), description: t('solutions.items.vendor.feat1Desc'), icon: 'tabler:shield' },
      { title: t('solutions.items.vendor.feat2Title'), description: t('solutions.items.vendor.feat2Desc'), icon: 'tabler:lock' },
      { title: t('solutions.items.vendor.feat3Title'), description: t('solutions.items.vendor.feat3Desc'), icon: 'tabler:eye' },
      { title: t('solutions.items.vendor.feat4Title'), description: t('solutions.items.vendor.feat4Desc'), icon: 'tabler:users' },
      { title: t('solutions.items.vendor.feat5Title'), description: t('solutions.items.vendor.feat5Desc'), icon: 'tabler:key' },
      { title: t('solutions.items.vendor.feat6Title'), description: t('solutions.items.vendor.feat6Desc'), icon: 'tabler:report' },
    ]}
  />

  <FAQs
    title={t('solutions.faqsTitle')}
    items={[
      { title: t('solutions.faq1Q'), description: t('solutions.faq1A') },
      { title: t('solutions.faq2Q'), description: t('solutions.faq2A') },
      { title: t('solutions.faq3Q'), description: t('solutions.faq3A') },
    ]}
  />

  <CallToAction actions={[{ variant: 'primary', text: t('common.requestDemo'), href: localePath('/contact') }]}>
    <Fragment slot="title">{t('solutions.items.vendor.ctaTitle')}</Fragment>
    <Fragment slot="subtitle">{t('solutions.items.vendor.ctaSubtitle')}</Fragment>
  </CallToAction>
</Layout>
