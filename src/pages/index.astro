---
import Layout from '~/layouts/PageLayout.astro';

import BlogHighlightedPosts from '~/components/widgets/BlogHighlightedPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

const metadata = {
  title: 'SecureHive — Privileged Access Management',
  ignoreTitleTemplate: true,
  description:
    'Enterprise Privileged Access Management for identity-centric security. Discover, control, and audit privileged access across your environment.',
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- ========== HERO with animated network background ========== -->
  <section class="sh-home-hero relative flex min-h-[calc(100svh-5rem)] flex-col justify-between overflow-hidden bg-[#0B2D5B] text-white">
    <sh-hero-canvas class="sh-hero-canvas absolute inset-0 pointer-events-none" aria-hidden="true">
      <canvas></canvas>
    </sh-hero-canvas>

    <!-- Animated cybersecurity network background -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <!-- Subtle grid -->
      <div
        class="absolute inset-0 opacity-[0.07]"
        style="background-image: linear-gradient(rgba(59,130,246,0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(59,130,246,0.4) 1px, transparent 1px); background-size: 48px 48px;"
      ></div>

      <!-- Soft radial vignette for readability -->
      <div
        class="absolute inset-0"
        style="background: radial-gradient(ellipse 80% 70% at 50% 40%, transparent 0%, rgba(11,45,91,0.55) 70%, rgba(11,45,91,0.85) 100%);"
      ></div>
    </div>

    <!-- Hero content -->
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32 lg:py-40">
      <div class="max-w-7xl">
        <p
          class="inline-flex items-center gap-2 text-sm font-medium text-blue-200 mb-6 intersect-once motion-safe:opacity-0 motion-safe:intersect:animate-fade"
        >
          <span class="inline-block w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
          Privileged Access Management
        </p>
        <h1 class="sh-hero-title mb-6 text-4xl font-bold leading-[1.06] tracking-tight text-white sm:text-5xl lg:text-[clamp(3.5rem,5vw,5.75rem)]">
          <span class="sh-hero-line"><span>Control privileged access.</span></span>
          <span class="sh-hero-line sh-hero-line-highlight"><span>Eliminate standing privilege.</span></span>
        </h1>
        <p
          class="max-w-3xl text-lg leading-relaxed text-slate-300 sm:text-xl mb-10 intersect-once motion-safe:opacity-0 motion-safe:intersect:animate-fade"
        >
          SecureHive is an enterprise Privileged Access Management platform — discover accounts, enforce just-in-time access, vault credentials, and record sessions so identity becomes your control plane.
        </p>
        <div
          class="flex flex-col sm:flex-row gap-4 intersect-once motion-safe:opacity-0 motion-safe:intersect:animate-fade"
        >
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-lg bg-[#3B82F6] text-white font-semibold text-base hover:bg-blue-500 transition-all duration-200 shadow-lg shadow-blue-500/25 hover:shadow-blue-500/40 hover:-translate-y-0.5"
          >
            Request a Demo
            <svg class="w-4 h-4 sh-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a
            href="/solutions"
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-lg border border-white/25 text-white font-semibold text-base hover:bg-white/10 transition-all duration-200"
          >
            Explore Solutions
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom fade into page background -->
    <div class="relative z-10 w-full pb-8 sm:pb-10">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="mb-4 text-sm font-medium text-blue-100/75">Security across the privileged access lifecycle</p>
        <div class="sh-capability-scroller" aria-label="SecureHive platform capabilities">
          <div class="sh-capability-track">
            <div class="sh-capability-set" role="list">
              <span role="listitem">Just-in-time access</span>
              <span role="listitem">Credential vaulting</span>
              <span role="listitem">Session oversight</span>
              <span role="listitem">Identity governance</span>
              <span role="listitem">Cloud entitlements</span>
            </div>
            <div class="sh-capability-set" role="list" aria-hidden="true">
              <span role="listitem">Just-in-time access</span>
              <span role="listitem">Credential vaulting</span>
              <span role="listitem">Session oversight</span>
              <span role="listitem">Identity governance</span>
              <span role="listitem">Cloud entitlements</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== TRUST / CREDIBILITY ========== -->
  <section class="py-14 bg-[#F8FAFC] border-b border-slate-200/80 dark:bg-[#07101f] dark:border-[#1c2c47]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="flex flex-wrap items-center justify-center gap-x-12 gap-y-6 text-slate-500 text-sm font-medium tracking-wide intersect-once motion-safe:opacity-0 motion-safe:intersect:animate-fade"
      >
        <span class="flex items-center gap-2">
          <svg class="w-5 h-5 text-[#0B2D5B] dark:text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
          </svg>
          Built for modern security teams
        </span>
        <span class="flex items-center gap-2">
          <svg class="w-5 h-5 text-[#0B2D5B] dark:text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
          </svg>
          Privileged Access Management
        </span>
        <span class="flex items-center gap-2">
          <svg class="w-5 h-5 text-[#0B2D5B] dark:text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
          </svg>
          Identity · Access · Endpoint · Cloud
        </span>
      </div>
    </div>
  </section>

  <!-- ========== SECURITY SOLUTIONS ========== -->
  <section class="py-20 md:py-28 bg-white dark:bg-[#07101f]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-14 intersect-once motion-safe:opacity-0 motion-safe:intersect:animate-fade">
        <p class="text-sm font-semibold text-[#3B82F6] tracking-wide uppercase mb-3">Solutions</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[#0B2D5B] tracking-tight mb-4 dark:text-slate-100">
          Comprehensive security across your enterprise
        </h2>
        <p class="text-lg text-slate-600 leading-relaxed dark:text-slate-300">
          Protect identities, control privileged access, secure endpoints, and govern cloud environments
          from a unified platform designed for enterprise scale.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          {
            title: 'Identity & Access Security',
            desc: 'Strengthen authentication, enforce least privilege, and continuously verify every identity across your organization.',
            icon: 'M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z',
          },
          {
            title: 'Privileged Access Management',
            desc: 'Discover, vault, and monitor privileged accounts with just-in-time access and session oversight.',
            icon: 'M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z',
          },
          {
            title: 'Endpoint Security',
            desc: 'Protect workstations, servers, and mobile devices with adaptive controls and continuous monitoring.',
            icon: 'M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25A2.25 2.25 0 015.25 3h13.5A2.25 2.25 0 0121 5.25z',
          },
          {
            title: 'Cloud Security',
            desc: 'Gain visibility and control across multi-cloud environments with configuration, identity, and workload protection.',
            icon: 'M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z',
          },
          {
            title: 'Security Automation',
            desc: 'Orchestrate response workflows, reduce alert fatigue, and accelerate investigation with intelligent automation.',
            icon: 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z',
          },
          {
            title: 'Unified Visibility',
            desc: 'Correlate signals across identity, access, and infrastructure for a single source of security truth.',
            icon: 'M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z M15 12a3 3 0 11-6 0 3 3 0 016 0z',
          },
        ].map((item, i) => (
          <div
            class={`sh-card group p-6 rounded-xl border border-slate-200 bg-white hover:border-blue-200 dark:border-[#1c2c47] dark:bg-[#0c172b] intersect-once motion-safe:opacity-0 motion-safe:intersect:animate-fade`}
            style={`--stagger: ${i * 60}ms`}
          >
            <div class="w-11 h-11 rounded-lg bg-[#0B2D5B]/5 flex items-center justify-center mb-4 group-hover:bg-[#0B2D5B]/10 transition-colors dark:bg-[#12213b]">
              <svg class="w-6 h-6 text-[#0B2D5B] dark:text-blue-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-[#0B2D5B] mb-2 dark:text-slate-100">{item.title}</h3>
            <p class="text-slate-600 text-sm leading-relaxed dark:text-slate-300">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== WHY SECUREHIVE ========== -->
  <section class="py-20 md:py-28 bg-[#F8FAFC] relative overflow-hidden dark:bg-[#0a1628]">
    <div class="absolute inset-0 sh-network-grid opacity-60 pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="intersect-once motion-safe:opacity-0 motion-safe:intersect:animate-fade">
          <p class="text-sm font-semibold text-[#3B82F6] tracking-wide uppercase mb-3">Why SecureHive</p>
          <h2 class="text-3xl md:text-4xl font-bold text-[#0B2D5B] tracking-tight mb-6 dark:text-slate-100">
            Designed for security teams who demand trust and clarity
          </h2>
          <p class="text-lg text-slate-600 leading-relaxed mb-8 dark:text-slate-300">
            SecureHive brings together identity-centric controls, privileged access governance, and
            infrastructure protection in a platform that prioritizes usability without sacrificing depth.
          </p>
          <ul class="space-y-4">
            {[
              'Unified control plane across identity, access, and infrastructure',
              'Policy-driven automation that reduces operational load',
              'Clear visibility for auditors, operators, and leadership',
              'Architecture built for hybrid and multi-cloud environments',
            ].map((text) => (
              <li class="flex items-start gap-3">
                <span class="mt-1 flex-shrink-0 w-5 h-5 rounded-full bg-blue-100 flex items-center justify-center">
                  <svg class="w-3 h-3 text-[#3B82F6]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                </span>
                <span class="text-slate-700 dark:text-slate-300">{text}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Decorative technical visual -->
        <div
          class="relative aspect-square max-w-md mx-auto lg:max-w-none intersect-once motion-safe:opacity-0 motion-safe:intersect:animate-fade"
          aria-hidden="true"
        >
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-[#0B2D5B] to-[#1E3A5F] overflow-hidden">
            <svg class="absolute inset-0 w-full h-full" viewBox="0 0 400 400" fill="none">
              <!-- Concentric shield geometry -->
              <path d="M200 40 L80 90 v80c0 70 50 120 120 140 70-20 120-70 120-140V90L200 40z" stroke="#3B82F6" stroke-opacity="0.3" stroke-width="1.5" fill="none" />
              <path d="M200 80 L120 115 v55c0 50 35 85 80 100 45-15 80-50 80-100v-55L200 80z" stroke="#3B82F6" stroke-opacity="0.45" stroke-width="1.5" fill="none" />
              <path d="M200 120 L155 142 v35c0 30 20 50 45 58 25-8 45-28 45-58v-35L200 120z" stroke="#60A5FA" stroke-opacity="0.6" stroke-width="1.5" fill="rgba(59,130,246,0.08)" />
              <!-- Nodes -->
              <circle cx="200" cy="200" r="8" fill="#3B82F6" />
              <circle cx="140" cy="160" r="4" fill="#60A5FA" opacity="0.8" />
              <circle cx="260" cy="160" r="4" fill="#60A5FA" opacity="0.8" />
              <circle cx="160" cy="250" r="4" fill="#60A5FA" opacity="0.8" />
              <circle cx="240" cy="250" r="4" fill="#60A5FA" opacity="0.8" />
              <line x1="200" y1="200" x2="140" y2="160" stroke="#3B82F6" stroke-opacity="0.4" />
              <line x1="200" y1="200" x2="260" y2="160" stroke="#3B82F6" stroke-opacity="0.4" />
              <line x1="200" y1="200" x2="160" y2="250" stroke="#3B82F6" stroke-opacity="0.4" />
              <line x1="200" y1="200" x2="240" y2="250" stroke="#3B82F6" stroke-opacity="0.4" />
              <!-- Pulse ring -->
              <circle cx="200" cy="200" r="20" stroke="#3B82F6" stroke-opacity="0.3" stroke-width="1" fill="none">
                <animate attributeName="r" values="16;32;16" dur="4s" repeatCount="indefinite" />
                <animate attributeName="stroke-opacity" values="0.4;0;0.4" dur="4s" repeatCount="indefinite" />
              </circle>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== INDUSTRIES ========== -->
  <section class="py-20 md:py-28 bg-white dark:bg-[#07101f]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-14 intersect-once motion-safe:opacity-0 motion-safe:intersect:animate-fade">
        <p class="text-sm font-semibold text-[#3B82F6] tracking-wide uppercase mb-3">Industries</p>
        <h2 class="text-3xl md:text-4xl font-bold text-[#0B2D5B] tracking-tight mb-4 dark:text-slate-100">
          Built for regulated and complex environments
        </h2>
        <p class="text-lg text-slate-600 dark:text-slate-300">
          SecureHive supports organizations that require rigorous access control, auditability, and operational resilience.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {[
          { name: 'Banking & Finance', desc: 'Protect high-value systems and privileged roles' },
          { name: 'Healthcare', desc: 'Safeguard patient data and clinical systems' },
          { name: 'Manufacturing', desc: 'Secure OT/IT convergence and supply chains' },
          { name: 'Government', desc: 'Meet stringent access and compliance needs' },
          { name: 'Education', desc: 'Defend research and student ecosystems' },
        ].map((ind) => (
          <div
            class="sh-card p-5 rounded-xl border border-slate-200 bg-[#F8FAFC] text-center dark:border-[#1c2c47] dark:bg-[#0c172b] intersect-once motion-safe:opacity-0 motion-safe:intersect:animate-fade"
          >
            <div class="w-10 h-10 mx-auto mb-3 rounded-lg bg-[#0B2D5B]/8 flex items-center justify-center">
              <svg class="w-5 h-5 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z" />
              </svg>
            </div>
            <h3 class="font-semibold text-[#0B2D5B] text-sm mb-1 dark:text-slate-100">{ind.name}</h3>
            <p class="text-xs text-slate-500 leading-snug dark:text-slate-400">{ind.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== RESOURCES / INSIGHTS ========== -->
  <BlogHighlightedPosts
    title="Latest insights"
    information="Practical guidance on privileged access, identity security, and enterprise cyber operations."
    postIds={[
      'top-trends-in-privileged-access-management-for-2026',
      'the-principle-of-least-privilege-a-practical-guide',
      'understanding-identity-threat-detection-and-response-itdr',
    ]}
  />


  <FAQs
    title="Frequently asked questions"
    subtitle="Quick answers about SecureHive Privileged Access Management."
    items={[
      {
        title: 'What is Privileged Access Management?',
        description:
          'PAM is the set of controls that govern elevated access to critical systems and secrets — who can get admin rights, for how long, and with what oversight. SecureHive focuses on discovery, just-in-time access, vaulting, and session accountability.',
      },
      {
        title: 'How is SecureHive different from our identity provider?',
        description:
          'Your IdP handles workforce login and SSO. SecureHive governs what happens after authentication when someone needs privileged access to servers, cloud consoles, or shared credentials.',
      },
      {
        title: 'Can we start with a limited pilot?',
        description:
          'Yes. Many teams begin with discovery and vaulting of shared admin accounts, or with vendor access, then expand to JIT and session controls.',
      },
      {
        title: 'Does SecureHive require replacing existing tools?',
        description:
          'No. SecureHive is designed to work alongside enterprise directories and identity providers. Deployment is typically phased rather than rip-and-replace.',
      },
      {
        title: 'Where can I learn more?',
        description:
          'Explore Products and Solutions, read the Blog for practical guidance, or Request a Demo to discuss your environment with our team.',
      },
    ]}
  />

  <!-- ========== FINAL CTA ========== -->
  <section class="relative py-20 md:py-28 bg-[#0B2D5B] overflow-hidden">
    <div class="absolute inset-0 pointer-events-none opacity-20" aria-hidden="true">
      <div
        class="absolute inset-0"
        style="background-image: linear-gradient(rgba(59,130,246,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(59,130,246,0.3) 1px, transparent 1px); background-size: 40px 40px;"
      ></div>
    </div>
    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 text-center intersect-once motion-safe:opacity-0 motion-safe:intersect:animate-fade">
      <h2 class="text-3xl md:text-4xl font-bold text-white tracking-tight mb-4">
        Ready to strengthen your security posture?
      </h2>
      <p class="text-lg text-slate-300 mb-10 max-w-xl mx-auto">
        Talk with our team about how SecureHive can support your identity, access, and infrastructure security goals.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-lg bg-[#3B82F6] text-white font-semibold hover:bg-blue-500 transition-all duration-200 shadow-lg shadow-blue-500/30 hover:-translate-y-0.5"
        >
          Request a Demo
          <svg class="w-4 h-4 sh-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-lg border border-white/25 text-white font-semibold hover:bg-white/10 transition-all duration-200"
        >
          Contact Sales
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .sh-hero-canvas canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .sh-home-hero > div[aria-hidden='true'] svg {
    display: none;
  }

  .sh-hero-title {
    max-width: 1100px;
  }

  .sh-hero-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .sh-hero-line > span {
    display: block;
    transform: translateY(110%);
    animation: sh-hero-rise 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  .sh-hero-line-highlight > span {
    color: #7db6ff;
    background: linear-gradient(100deg, #7db6ff 20%, #d9ecff 45%, #7db6ff 70%);
    background-size: 220% 100%;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: sh-hero-rise 0.9s 0.16s cubic-bezier(0.2, 0.8, 0.2, 1) forwards, sh-hero-shine 5s 1.2s linear infinite;
  }

  .sh-capability-scroller {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }

  .sh-capability-track,
  .sh-capability-set {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 0.75rem;
  }

  .sh-capability-track {
    animation: sh-capability-scroll 32s linear infinite;
  }

  .sh-capability-scroller:hover .sh-capability-track {
    animation-play-state: paused;
  }

  .sh-capability-set > span {
    flex: none;
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    background: rgb(255 255 255 / 5%);
    color: #e5eefc;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
  }

  @keyframes sh-hero-rise {
    to { transform: translateY(0); }
  }

  @keyframes sh-hero-shine {
    to { background-position: -220% 0; }
  }

  @keyframes sh-capability-scroll {
    to { transform: translateX(-50%); }
  }

  @media (max-width: 640px) {
    .sh-capability-set > span {
      padding: 0.625rem 0.75rem;
      font-size: 0.8125rem;
    }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .sh-hero-line > span,
    .sh-capability-track {
      animation: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  class SecureHiveHeroCanvas extends HTMLElement {
    private canvas: HTMLCanvasElement | null = null;
    private context: CanvasRenderingContext2D | null = null;
    private cells: Array<[number, number]> = [];
    private animationFrame = 0;
    private resizeObserver?: ResizeObserver;
    private pointerX = -999;
    private pointerY = -999;
    private reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    private resize = () => {
      if (!this.canvas || !this.context) return;

      const { width, height } = this.getBoundingClientRect();
      if (!width || !height) return;

      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      this.canvas.width = Math.round(width * ratio);
      this.canvas.height = Math.round(height * ratio);
      this.context.setTransform(ratio, 0, 0, ratio, 0, 0);

      const radius = 40;
      const hexWidth = Math.sqrt(3) * radius;
      this.cells = [];
      for (let row = -1; row < height / (1.5 * radius) + 2; row += 1) {
        for (let column = -1; column < width / hexWidth + 2; column += 1) {
          this.cells.push([column * hexWidth + (row % 2 ? hexWidth / 2 : 0), row * 1.5 * radius]);
        }
      }
    };

    private onPointerMove = (event: PointerEvent) => {
      const bounds = this.getBoundingClientRect();
      this.pointerX = event.clientX - bounds.left;
      this.pointerY = event.clientY - bounds.top;
    };

    private onPointerLeave = () => {
      this.pointerX = -999;
      this.pointerY = -999;
    };

    private draw = (timestamp: number) => {
      if (!this.context) return;

      const time = timestamp / 1000;
      const radius = 40;
      this.context.clearRect(0, 0, this.clientWidth, this.clientHeight);

      for (const [centerX, centerY] of this.cells) {
        const distance = Math.hypot(centerX - this.clientWidth * 0.72, centerY - this.clientHeight * 0.35);
        const wave = Math.max(0, Math.sin(distance / 95 - time * 1.3));
        const spotlight = Math.max(0, 1 - Math.hypot(centerX - this.pointerX, centerY - this.pointerY) / 190);
        const alpha = 0.055 + wave * 0.2 * Math.max(0, 1 - distance / 1000) + spotlight * 0.5;

        this.context.beginPath();
        for (let side = 0; side < 6; side += 1) {
          const angle = (Math.PI / 3) * side + Math.PI / 6;
          const x = centerX + (radius - 2) * Math.cos(angle);
          const y = centerY + (radius - 2) * Math.sin(angle);
          if (side === 0) this.context.moveTo(x, y);
          else this.context.lineTo(x, y);
        }
        this.context.closePath();
        this.context.strokeStyle = `rgba(125, 182, 255, ${alpha})`;
        this.context.lineWidth = 1;
        this.context.stroke();
        if (alpha > 0.28) {
          this.context.fillStyle = `rgba(88, 157, 255, ${(alpha - 0.28) * 0.22})`;
          this.context.fill();
        }
      }

      if (!this.reducedMotion) this.animationFrame = requestAnimationFrame(this.draw);
    };

    connectedCallback() {
      this.canvas = this.querySelector('canvas');
      this.context = this.canvas?.getContext('2d') ?? null;
      if (!this.context) return;

      if (typeof ResizeObserver !== 'undefined') {
        this.resizeObserver = new ResizeObserver(this.resize);
        this.resizeObserver.observe(this);
      } else {
        window.addEventListener('resize', this.resize);
      }

      this.parentElement?.addEventListener('pointermove', this.onPointerMove);
      this.parentElement?.addEventListener('pointerleave', this.onPointerLeave);
      this.resize();
      this.animationFrame = requestAnimationFrame(this.draw);
    }

    disconnectedCallback() {
      cancelAnimationFrame(this.animationFrame);
      this.resizeObserver?.disconnect();
      window.removeEventListener('resize', this.resize);
      this.parentElement?.removeEventListener('pointermove', this.onPointerMove);
      this.parentElement?.removeEventListener('pointerleave', this.onPointerLeave);
    }
  }

  if (!customElements.get('sh-hero-canvas')) {
    customElements.define('sh-hero-canvas', SecureHiveHeroCanvas);
  }
</script>
