<script>
  type Node = {
    x: number;
    y: number;
    vx: number;
    vy: number;
    r: number;
    z: number;
    hub: boolean;
    pulse: number;
    scanId: number;
    sx: number;
    sy: number;
    phase: number;
  };

  type Packet = { a: number; b: number; t: number; hops: number; hue: 0 | 1 };

  class SecureHiveHeroCanvas extends HTMLElement {
    private canvas: HTMLCanvasElement | null = null;
    private ctx: CanvasRenderingContext2D | null = null;
    private w = 0;
    private h = 0;
    private nodes: Node[] = [];
    private packets: Packet[] = [];
    private neighbors: number[][] = [];
    private hexLayer: HTMLCanvasElement | null = null;
    private glowBlue: HTMLCanvasElement | null = null;
    private glowCyan: HTMLCanvasElement | null = null;
    private raf = 0;
    private running = false;
    private last = 0;
    private time = 0;
    private spawnTimer = 0;
    private scanId = 0;
    private lastScanPhase = 0;
    private resizeObserver?: ResizeObserver;
    private intersectionObserver?: IntersectionObserver;
    private pointerX = -999;
    private pointerY = -999;
    private px = 0;
    private py = 0;
    private reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    private static LINK = 150;
    private static SCAN_PERIOD = 8;

    private makeGlow(rgb: string) {
      const c = document.createElement('canvas');
      c.width = c.height = 64;
      const g = c.getContext('2d')!;
      const grad = g.createRadialGradient(32, 32, 0, 32, 32, 32);
      grad.addColorStop(0, `rgba(${rgb}, 1)`);
      grad.addColorStop(0.25, `rgba(${rgb}, 0.45)`);
      grad.addColorStop(1, `rgba(${rgb}, 0)`);
      g.fillStyle = grad;
      g.fillRect(0, 0, 64, 64);
      return c;
    }

    private buildHexLayer() {
      const layer = document.createElement('canvas');
      layer.width = this.canvas!.width;
      layer.height = this.canvas!.height;
      const g = layer.getContext('2d')!;
      const ratio = layer.width / this.w;
      g.setTransform(ratio, 0, 0, ratio, 0, 0);
      const radius = 38;
      const hexW = Math.sqrt(3) * radius;
      g.strokeStyle = 'rgba(15, 164, 175, 1)';
      g.lineWidth = 1;
      for (let row = -1; row < this.h / (1.5 * radius) + 2; row++) {
        for (let col = -1; col < this.w / hexW + 2; col++) {
          const cx = col * hexW + (row % 2 ? hexW / 2 : 0);
          const cy = row * 1.5 * radius;
          g.beginPath();
          for (let s = 0; s < 6; s++) {
            const a = (Math.PI / 3) * s + Math.PI / 6;
            const x = cx + (radius - 1.5) * Math.cos(a);
            const y = cy + (radius - 1.5) * Math.sin(a);
            if (s === 0) g.moveTo(x, y);
            else g.lineTo(x, y);
          }
          g.closePath();
          g.stroke();
        }
      }
      this.hexLayer = layer;
    }

    private seedNodes() {
      const count = Math.max(36, Math.min(105, Math.round((this.w * this.h) / 15000)));
      this.nodes = Array.from({ length: count }, (_, i) => {
        const z = 0.45 + Math.random() * 0.55;
        const hub = i % 9 === 0;
        const speed = (6 + Math.random() * 12) * z;
        const dir = Math.random() * Math.PI * 2;
        return {
          x: Math.random() * this.w,
          y: Math.random() * this.h,
          vx: Math.cos(dir) * speed,
          vy: Math.sin(dir) * speed,
          r: hub ? 3.4 : 1.2 + Math.random() * 1.4,
          z,
          hub,
          pulse: 0,
          scanId: -1,
          sx: 0,
          sy: 0,
          phase: Math.random() * Math.PI * 2,
        };
      });
      this.packets = [];
    }

    private resize = () => {
      if (!this.canvas || !this.ctx) return;
      const { width, height } = this.getBoundingClientRect();
      if (!width || !height) return;

      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      const firstRun = this.nodes.length === 0;
      const oldW = this.w;
      const oldH = this.h;

      this.w = width;
      this.h = height;
      this.canvas.width = Math.round(width * ratio);
      this.canvas.height = Math.round(height * ratio);
      this.ctx.setTransform(ratio, 0, 0, ratio, 0, 0);

      if (firstRun) {
        this.seedNodes();
      } else {
        for (const n of this.nodes) {
          n.x *= width / oldW;
          n.y *= height / oldH;
        }
      }
      this.buildHexLayer();
      if (this.reducedMotion) this.draw(performance.now());
    };

    private onPointerMove = (e: PointerEvent) => {
      const b = this.getBoundingClientRect();
      this.pointerX = e.clientX - b.left;
      this.pointerY = e.clientY - b.top;
    };

    private onPointerLeave = () => {
      this.pointerX = -999;
      this.pointerY = -999;
    };

    private spawnPacket() {
      const candidates: number[] = [];
      for (let i = 0; i < this.neighbors.length; i++) if (this.neighbors[i].length) candidates.push(i);
      if (!candidates.length) return;
      const a = candidates[(Math.random() * candidates.length) | 0];
      const list = this.neighbors[a];
      const b = list[(Math.random() * list.length) | 0];
      this.packets.push({ a, b, t: 0, hops: 2 + ((Math.random() * 4) | 0), hue: Math.random() < 0.3 ? 1 : 0 });
    }

    private draw = (timestamp: number) => {
      const ctx = this.ctx;
      if (!ctx || !this.w) return;

      const dt = this.reducedMotion ? 0 : Math.min(0.05, (timestamp - (this.last || timestamp)) / 1000);
      this.last = timestamp;
      this.time = this.reducedMotion ? 3 : this.time + dt;

      const { w, h, nodes } = this;
      const LINK = SecureHiveHeroCanvas.LINK;
      const LINK2 = LINK * LINK;

      ctx.clearRect(0, 0, w, h);

      // --- Pointer parallax (smoothed) ---
      const tx = this.pointerX > -900 ? (this.pointerX - w / 2) / w : 0;
      const ty = this.pointerY > -900 ? (this.pointerY - h / 2) / h : 0;
      this.px += (tx - this.px) * Math.min(1, dt * 3);
      this.py += (ty - this.py) * Math.min(1, dt * 3);

      // --- Base hex grid ---
      if (this.hexLayer) {
        ctx.globalAlpha = 0.055;
        ctx.drawImage(this.hexLayer, 0, 0, w, h);
        ctx.globalAlpha = 1;
      }

      // --- Verification scan ring ---
      const ox = w * 0.72;
      const oy = h * 0.38;
      const maxR = Math.hypot(Math.max(ox, w - ox), Math.max(oy, h - oy)) * 1.05;
      const phase = (this.time % SecureHiveHeroCanvas.SCAN_PERIOD) / SecureHiveHeroCanvas.SCAN_PERIOD;
      if (phase < this.lastScanPhase) this.scanId++;
      this.lastScanPhase = phase;
      const ringR = phase * maxR;
      const band = 140;
      const fade = Math.sin(Math.min(1, phase * 1.1) * Math.PI) * 0.9 + 0.1;

      if (this.hexLayer && ringR > 4) {
        ctx.save();
        ctx.beginPath();
        ctx.arc(ox, oy, ringR, 0, Math.PI * 2);
        ctx.arc(ox, oy, Math.max(0, ringR - band), 0, Math.PI * 2, true);
        ctx.clip('evenodd');
        ctx.globalAlpha = 0.5 * fade;
        ctx.drawImage(this.hexLayer, 0, 0, w, h);
        ctx.restore();
        ctx.globalAlpha = 1;

        ctx.beginPath();
        ctx.arc(ox, oy, ringR, 0, Math.PI * 2);
        ctx.strokeStyle = `rgba(15, 164, 175, ${0.22 * fade})`;
        ctx.lineWidth = 1.5;
        ctx.stroke();
      }

      // --- Update nodes ---
      for (const n of nodes) {
        n.x += n.vx * dt;
        n.y += n.vy * dt;
        if (n.x < -30) n.x = w + 30;
        else if (n.x > w + 30) n.x = -30;
        if (n.y < -30) n.y = h + 30;
        else if (n.y > h + 30) n.y = -30;

        // gentle pointer attraction
        const dxp = this.pointerX - n.x;
        const dyp = this.pointerY - n.y;
        const dp = Math.hypot(dxp, dyp);
        if (dp < 220 && dp > 1) {
          const f = (1 - dp / 220) * 14 * dt;
          n.x += (dxp / dp) * f;
          n.y += (dyp / dp) * f;
        }

        n.sx = n.x + this.px * 50 * n.z;
        n.sy = n.y + this.py * 50 * n.z;

        // scan hit
        const sd = Math.hypot(n.x - ox, n.y - oy);
        if (n.scanId !== this.scanId && sd < ringR && sd > ringR - band * 0.5) {
          n.scanId = this.scanId;
          n.pulse = 1;
        }
        n.pulse = Math.max(0, n.pulse - dt * 0.9);
      }

      // --- Links + adjacency ---
      if (this.neighbors.length !== nodes.length) this.neighbors = nodes.map(() => []);
      for (const list of this.neighbors) list.length = 0;

      ctx.lineWidth = 1;
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          const dx = a.sx - b.sx;
          const dy = a.sy - b.sy;
          const d2 = dx * dx + dy * dy;
          if (d2 > LINK2) continue;
          const d = Math.sqrt(d2);
          this.neighbors[i].push(j);
          this.neighbors[j].push(i);
          const hot = Math.max(a.pulse, b.pulse);
          const alpha = (1 - d / LINK) * 0.3 * Math.min(a.z, b.z) + hot * 0.25 * (1 - d / LINK);
          ctx.strokeStyle = hot > 0.05 ? `rgba(120, 230, 235, ${alpha})` : `rgba(15, 164, 175, ${alpha})`;
          ctx.beginPath();
          ctx.moveTo(a.sx, a.sy);
          ctx.lineTo(b.sx, b.sy);
          ctx.stroke();
        }
      }

      // --- Pointer links + glow ---
      if (this.pointerX > -900 && this.glowBlue) {
        for (const n of nodes) {
          const d = Math.hypot(n.sx - this.pointerX, n.sy - this.pointerY);
          if (d < 200) {
            ctx.strokeStyle = `rgba(15, 164, 175, ${(1 - d / 200) * 0.5})`;
            ctx.beginPath();
            ctx.moveTo(this.pointerX, this.pointerY);
            ctx.lineTo(n.sx, n.sy);
            ctx.stroke();
          }
        }
        ctx.globalCompositeOperation = 'lighter';
        ctx.globalAlpha = 0.5;
        ctx.drawImage(this.glowBlue, this.pointerX - 150, this.pointerY - 150, 300, 300);
        ctx.globalAlpha = 1;
        ctx.globalCompositeOperation = 'source-over';
      }

      // --- Packets ---
      if (!this.reducedMotion) {
        this.spawnTimer -= dt;
        if (this.spawnTimer <= 0 && this.packets.length < Math.max(8, nodes.length * 0.35)) {
          this.spawnPacket();
          this.spawnTimer = 0.12 + Math.random() * 0.25;
        }
      }

      ctx.globalCompositeOperation = 'lighter';
      for (let i = this.packets.length - 1; i >= 0; i--) {
        const p = this.packets[i];
        const a = nodes[p.a];
        const b = nodes[p.b];
        const len = Math.hypot(b.sx - a.sx, b.sy - a.sy);
        if (len > LINK * 1.3 || len < 1) {
          this.packets.splice(i, 1);
          continue;
        }
        p.t += ((200 / len) * dt) | 0 || (200 / len) * dt;
        if (p.t >= 1) {
          b.pulse = Math.max(b.pulse, 0.8);
          const options = this.neighbors[p.b].filter((k) => k !== p.a);
          if (p.hops > 0 && options.length) {
            p.a = p.b;
            p.b = options[(Math.random() * options.length) | 0];
            p.t = 0;
            p.hops--;
          } else {
            this.packets.splice(i, 1);
          }
          continue;
        }
        const glow = p.hue ? this.glowCyan : this.glowBlue;
        if (!glow) continue;
        for (let k = 0; k < 6; k++) {
          const tt = Math.max(0, p.t - k * 0.03);
          const x = a.sx + (b.sx - a.sx) * tt;
          const y = a.sy + (b.sy - a.sy) * tt;
          const size = (k === 0 ? 20 : 14) * (1 - k * 0.12);
          ctx.globalAlpha = (k === 0 ? 1 : 0.55) * (1 - k / 6);
          ctx.drawImage(glow, x - size / 2, y - size / 2, size, size);
        }
      }
      ctx.globalAlpha = 1;

      // --- Nodes ---
      for (const n of nodes) {
        const breathe = 0.7 + 0.3 * Math.sin(this.time * 1.4 + n.phase);
        const glowSize = (n.hub ? 34 : 18) + n.pulse * 40;
        const glow = n.pulse > 0.05 ? this.glowCyan : this.glowBlue;
        if (glow) {
          ctx.globalAlpha = (0.3 + n.pulse * 0.7) * n.z * breathe;
          ctx.drawImage(glow, n.sx - glowSize / 2, n.sy - glowSize / 2, glowSize, glowSize);
        }
      }
      ctx.globalCompositeOperation = 'source-over';
      ctx.globalAlpha = 1;

      for (const n of nodes) {
        ctx.fillStyle =
          n.pulse > 0.05 ? `rgba(190, 255, 250, ${0.7 + n.pulse * 0.3})` : `rgba(200, 245, 240, ${0.5 * n.z + 0.3})`;
        ctx.beginPath();
        ctx.arc(n.sx, n.sy, n.r * (1 + n.pulse * 0.6), 0, Math.PI * 2);
        ctx.fill();

        if (n.hub) {
          const rr = 8 + Math.sin(this.time * 1.2 + n.phase) * 1.5 + n.pulse * 10;
          ctx.strokeStyle = `rgba(15, 164, 175, ${0.35 + n.pulse * 0.4})`;
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.arc(n.sx, n.sy, rr, this.time * 0.6 + n.phase, this.time * 0.6 + n.phase + Math.PI * 1.35);
          ctx.stroke();
          ctx.beginPath();
          ctx.arc(n.sx, n.sy, rr + 5, -this.time * 0.4 + n.phase, -this.time * 0.4 + n.phase + Math.PI * 0.8);
          ctx.strokeStyle = `rgba(15, 164, 175, ${0.18 + n.pulse * 0.3})`;
          ctx.stroke();
        }
      }

      if (this.running && !this.reducedMotion) this.raf = requestAnimationFrame(this.draw);
    };

    private start() {
      if (this.running || this.reducedMotion) return;
      this.running = true;
      this.last = 0;
      this.raf = requestAnimationFrame(this.draw);
    }

    private stop() {
      this.running = false;
      cancelAnimationFrame(this.raf);
    }

    connectedCallback() {
      this.canvas = this.querySelector('canvas');
      this.ctx = this.canvas?.getContext('2d') ?? null;
      if (!this.ctx) return;

      this.glowBlue = this.makeGlow('110, 175, 255');
      this.glowCyan = this.makeGlow('110, 235, 230');

      if (typeof ResizeObserver !== 'undefined') {
        this.resizeObserver = new ResizeObserver(this.resize);
        this.resizeObserver.observe(this);
      } else {
        window.addEventListener('resize', this.resize);
      }

      this.parentElement?.addEventListener('pointermove', this.onPointerMove);
      this.parentElement?.addEventListener('pointerleave', this.onPointerLeave);
      this.resize();

      if (typeof IntersectionObserver !== 'undefined') {
        this.intersectionObserver = new IntersectionObserver(([entry]) => {
          if (entry.isIntersecting) this.start();
          else this.stop();
        });
        this.intersectionObserver.observe(this);
      } else {
        this.start();
      }
    }

    disconnectedCallback() {
      this.stop();
      this.resizeObserver?.disconnect();
      this.intersectionObserver?.disconnect();
      window.removeEventListener('resize', this.resize);
      this.parentElement?.removeEventListener('pointermove', this.onPointerMove);
      this.parentElement?.removeEventListener('pointerleave', this.onPointerLeave);
    }
  }

  if (!customElements.get('sh-hero-canvas')) {
    customElements.define('sh-hero-canvas', SecureHiveHeroCanvas);
  }
</script>
