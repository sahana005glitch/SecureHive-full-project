---
import Layout from '~/layouts/PageLayout.astro';

import InsightsCarousel from '~/components/widgets/InsightsCarousel.astro';
import { Icon } from 'astro-icon/components';
import FAQs from '~/components/widgets/FAQs.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, I18N } from 'astrowind:config';
import { useTranslations } from '~/i18n/translations';
import { getLocalizedPath } from '~/i18n/routes';
import favIconSvg from '~/assets/favicons/favicon.svg';

const locale = Astro.currentLocale || 'en';
const { t } = useTranslations(locale);
const localePath = (path: string) => getLocalizedPath(path, locale);

const metadata = {
  title: t('home.metaTitle'),
  ignoreTitleTemplate: true,
  description: t('home.metaDescription'),
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: Astro.currentLocale || I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- ========== HERO with animated network background ========== -->
  <section
    class="sh-home-hero relative flex min-h-[calc(100svh-5rem)] flex-col justify-between overflow-hidden bg-dark text-white"
  >
    <sh-hero-canvas class="sh-hero-canvas absolute inset-0 pointer-events-none" aria-hidden="true">
      <canvas></canvas>
    </sh-hero-canvas>

    <!-- Animated cybersecurity network background -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <!-- Subtle grid -->
      <div
        class="absolute inset-0 opacity-[0.07]"
        style="background-image: linear-gradient(rgba(15,164,175,0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(15,164,175,0.4) 1px, transparent 1px); background-size: 48px 48px;"
      >
      </div>

      <!-- Soft radial vignette for readability -->
      <div class="sh-hero-vignette absolute inset-0"></div>
    </div>

    <!-- Hero content -->
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32 lg:py-40">
      <div class="max-w-7xl">
        <p
          class="inline-flex items-center gap-2 text-sm font-medium text-accent mb-6 intersect-once motion-safe:opacity-0 motion-safe:intersect:animate-fade"
        >
          <span class="inline-block w-2 h-2 rounded-full bg-brand-warm animate-pulse"></span>
          {t('home.heroBadge')}
        </p>
        <h1
          class="sh-hero-title mb-6 text-4xl font-bold leading-[1.06] tracking-tight text-white dark:text-heading sm:text-5xl lg:text-[clamp(3.5rem,5vw,5.75rem)]"
        >
          <span class="sh-hero-line"><span>{t('home.heroTitle1')}</span></span>
          <span class="sh-hero-line sh-hero-line-highlight"><span>{t('home.heroTitle2')}</span></span>
        </h1>
        <p
          class="max-w-3xl text-lg leading-relaxed text-slate-300 dark:text-default sm:text-xl mb-10 intersect-once motion-safe:opacity-0 motion-safe:intersect:animate-fade"
        >
          {t('home.heroSubtitle')}
        </p>
        <div
          class="flex flex-col sm:flex-row gap-4 intersect-once motion-safe:opacity-0 motion-safe:intersect:animate-fade"
        >
          <a
            href={localePath('/contact')}
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-lg bg-brand-warm text-white font-semibold text-base hover:bg-[#7A392A] transition-all duration-200 shadow-lg shadow-brand-warm/25 hover:shadow-brand-warm/40 hover:-translate-y-0.5 dark:!bg-primary dark:!text-[#081426] dark:hover:!bg-secondary dark:shadow-cyan-400/25"
          >
            {t('common.requestDemo')}
            <svg class="w-4 h-4 sh-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
            </svg>
          </a>
          <a
            href={localePath('/solutions')}
            class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-lg border border-white/25 text-white font-semibold text-base hover:bg-white/10 transition-all duration-200"
          >
            {t('common.exploreSolutions')}
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom fade into page background -->
    <div class="relative z-10 w-full pb-8 sm:pb-10">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="mb-4 text-sm font-medium text-teal-100/75">{t('home.lifecycleTagline')}</p>
        <div class="sh-capability-scroller" aria-label={t('home.lifecycleTitle')}>
          <div class="sh-capability-track">
            <div class="sh-capability-set" role="list">
              <span role="listitem">{t('home.capJit')}</span>
              <span role="listitem">{t('home.capVault')}</span>
              <span role="listitem">{t('home.capSession')}</span>
              <span role="listitem">{t('home.capGovernance')}</span>
              <span role="listitem">{t('home.capCloud')}</span>
            </div>
            <div class="sh-capability-set" role="list" aria-hidden="true">
              <span role="listitem">{t('home.capJit')}</span>
              <span role="listitem">{t('home.capVault')}</span>
              <span role="listitem">{t('home.capSession')}</span>
              <span role="listitem">{t('home.capGovernance')}</span>
              <span role="listitem">{t('home.capCloud')}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== TRUST / CREDIBILITY ========== -->
  <section class="py-14 bg-page border-b border-slate-200/80 dark:bg-section dark:border-theme">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="flex flex-wrap items-center justify-center gap-x-12 gap-y-6 text-slate-500 text-sm font-medium tracking-wide intersect-once motion-safe:opacity-0 motion-safe:intersect:animate-fade"
      >
        <span class="flex items-center gap-2">
          <svg
            class="w-5 h-5 text-primary dark:text-secondary"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"
            ></path>
          </svg>
          {t('home.scaleTagline')}
        </span>
        <span class="flex items-center gap-2">
          <svg
            class="w-5 h-5 text-primary dark:text-secondary"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"></path>
          </svg>
          {t('home.heroBadge')}
        </span>
        <span class="flex items-center gap-2">
          <svg
            class="w-5 h-5 text-primary dark:text-secondary"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"></path>
          </svg>
          {t('home.scaleTitle')}
        </span>
      </div>
    </div>
  </section>

  <!-- ========== SECURITY SOLUTIONS ========== -->
  <!-- ========== SECURITY SOLUTIONS ========== -->
  <section class="sh-solutions-bg relative overflow-hidden py-20 md:py-28">
    <div class="sh-dots absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-14 intersect-once motion-safe:opacity-0 motion-safe:intersect:animate-fade">
        <p class="text-sm font-semibold text-brand-warm tracking-wide uppercase mb-3">{t('home.solutionsTagline')}</p>
        <h2 class="text-3xl md:text-4xl font-bold text-primary tracking-tight mb-4 dark:text-heading">
          {t('home.solutionsTitle')}
        </h2>
        <p class="text-lg text-slate-600 leading-relaxed dark:text-default">
          {t('home.solutionsSubtitle')}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          [
            {
              title: t('home.solIdentityTitle'),
              desc: t('home.solIdentityDesc'),
              icon: 'M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z',
            },
            {
              title: t('home.solPamTitle'),
              desc: t('home.solPamDesc'),
              icon: 'M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z',
            },
            {
              title: t('home.solEndpointTitle'),
              desc: t('home.solEndpointDesc'),
              icon: 'M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25A2.25 2.25 0 015.25 3h13.5A2.25 2.25 0 0121 5.25z',
            },
            {
              title: t('home.solCloudTitle'),
              desc: t('home.solCloudDesc'),
              icon: 'M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z',
            },
            {
              title: t('home.solAutomationTitle'),
              desc: t('home.solAutomationDesc'),
              icon: 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z',
            },
            {
              title: t('home.solVisibilityTitle'),
              desc: t('home.solVisibilityDesc'),
              icon: 'M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z M15 12a3 3 0 11-6 0 3 3 0 016 0z',
            },
          ].map((item, i) => (
            <div
              class="sh-feature-card group p-6 intersect-once motion-safe:opacity-0 motion-safe:intersect:animate-fade"
              style={`--stagger: ${i * 60}ms`}
            >
              <div class="sh-icon-tile w-11 h-11 rounded-lg flex items-center justify-center mb-4">
                <svg
                  class="w-6 h-6 text-primary dark:text-primary"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-primary mb-2 dark:text-heading">{item.title}</h3>
              <p class="text-slate-600 text-sm leading-relaxed dark:text-default">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========== WHY SECUREHIVE ========== -->
  <!-- ========== WHY SECUREHIVE ========== -->
  <section class="sh-why-bg relative overflow-hidden py-20 md:py-28">
    <div class="sh-why-hex absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="sh-why-glow absolute inset-0 pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="intersect-once motion-safe:opacity-0 motion-safe:intersect:animate-fade">
          <p class="text-sm font-semibold text-brand-warm tracking-wide uppercase mb-3">{t('home.whyTagline')}</p>
          <h2 class="text-3xl md:text-4xl font-bold text-primary tracking-tight mb-6 dark:text-heading">
            {t('home.whyTitle')}
          </h2>
          <p class="text-lg text-slate-600 leading-relaxed mb-8 dark:text-default">
            {t('home.whySubtitle')}
          </p>
          <ul class="space-y-4">
            {
              [t('home.whyPoint1'), t('home.whyPoint2'), t('home.whyPoint3'), t('home.whyPoint4')].map((text) => (
                <li class="flex items-start gap-3">
                  <span class="mt-1 flex-shrink-0 w-5 h-5 rounded-full bg-accent/10 flex items-center justify-center dark:bg-primary/15">
                    <svg
                      class="w-3 h-3 text-accent"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="3"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                  </span>
                  <span class="text-slate-700 dark:text-default">{text}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Decorative technical visual -->
        <div
          class="relative aspect-square max-w-md mx-auto lg:max-w-none intersect-once motion-safe:opacity-0 motion-safe:intersect:animate-fade"
          aria-hidden="true"
        >
          <div
            class="absolute inset-0 rounded-2xl bg-gradient-to-br from-secondary to-primary overflow-hidden shadow-2xl shadow-primary/30 ring-1 ring-accent/20"
          >
            <svg class="absolute inset-0 w-full h-full" viewBox="0 0 400 400" fill="none">
              <path
                d="M200 40 L80 90 v80c0 70 50 120 120 140 70-20 120-70 120-140V90L200 40z"
                stroke="#0FA4AF"
                stroke-opacity="0.3"
                stroke-width="1.5"
                fill="none"></path>
              <path
                d="M200 80 L120 115 v55c0 50 35 85 80 100 45-15 80-50 80-100v-55L200 80z"
                stroke="#0FA4AF"
                stroke-opacity="0.45"
                stroke-width="1.5"
                fill="none"></path>
              <path
                d="M200 120 L155 142 v35c0 30 20 50 45 58 25-8 45-28 45-58v-35L200 120z"
                stroke="#964734"
                stroke-opacity="0.6"
                stroke-width="1.5"
                fill="rgba(15,164,175,0.08)"></path>
              <circle cx="200" cy="200" r="8" fill="#0FA4AF"></circle>
              <circle cx="140" cy="160" r="4" fill="#964734" opacity="0.8"></circle>
              <circle cx="260" cy="160" r="4" fill="#964734" opacity="0.8"></circle>
              <circle cx="160" cy="250" r="4" fill="#964734" opacity="0.8"></circle>
              <circle cx="240" cy="250" r="4" fill="#964734" opacity="0.8"></circle>
              <line x1="200" y1="200" x2="140" y2="160" stroke="#0FA4AF" stroke-opacity="0.4"></line>
              <line x1="200" y1="200" x2="260" y2="160" stroke="#0FA4AF" stroke-opacity="0.4"></line>
              <line x1="200" y1="200" x2="160" y2="250" stroke="#0FA4AF" stroke-opacity="0.4"></line>
              <line x1="200" y1="200" x2="240" y2="250" stroke="#0FA4AF" stroke-opacity="0.4"></line>
              <circle cx="200" cy="200" r="20" stroke="#0FA4AF" stroke-opacity="0.3" stroke-width="1" fill="none">
                <animate attributeName="r" values="16;32;16" dur="4s" repeatCount="indefinite"></animate>
                <animate attributeName="stroke-opacity" values="0.4;0;0.4" dur="4s" repeatCount="indefinite"></animate>
              </circle>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== INDUSTRIES ========== -->
  <section class="py-20 md:py-28 bg-white dark:bg-section">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="text-center max-w-2xl mx-auto mb-14 intersect-once motion-safe:opacity-0 motion-safe:intersect:animate-fade"
      >
        <p class="text-sm font-semibold text-brand-warm tracking-wide uppercase mb-3">{t('home.indTagline')}</p>
        <h2 class="text-3xl md:text-4xl font-bold text-primary tracking-tight mb-4 dark:text-heading">
          {t('home.indTitle')}
        </h2>
        <p class="text-lg text-slate-600 dark:text-default">
          {t('home.indSubtitle')}
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {
          [
            { name: t('home.indFinance'), desc: t('home.indFinanceDesc') },
            { name: t('home.indHealthcare'), desc: t('home.indHealthcareDesc') },
            { name: t('home.indMfg'), desc: t('home.indMfgDesc') },
            { name: t('home.indGov'), desc: t('home.indGovDesc') },
            { name: t('home.indEdu'), desc: t('home.indEduDesc') },
          ].map((ind) => (
            <div class="sh-card p-5 rounded-xl border border-slate-200 bg-page text-center dark:border-theme dark:bg-card-surface intersect-once motion-safe:opacity-0 motion-safe:intersect:animate-fade">
              <div class="w-10 h-10 mx-auto mb-3 rounded-lg bg-primary/8 flex items-center justify-center">
                <svg
                  class="w-5 h-5 text-accent"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z"
                  />
                </svg>
              </div>
              <h3 class="font-semibold text-primary text-sm mb-1 dark:text-heading">{ind.name}</h3>
              <p class="text-xs text-slate-500 leading-snug dark:text-muted">{ind.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========== PLATFORM BREADTH ========== -->
  <section class="sh-platform-section bg-page py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-12 max-w-3xl text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-brand-warm">
          {t('home.platformTagline')}
        </p>
        <h2 class="mb-4 text-3xl font-bold tracking-tight text-heading md:text-4xl">
          {t('home.platformTitle')}
        </h2>
        <p class="text-lg leading-relaxed text-muted">{t('home.platformSubtitle')}</p>
      </div>

      <div class="grid gap-5 lg:grid-cols-3">
        {
          [
            {
              key: 'identity',
              title: t('home.platformIdentity'),
              items: [
                {
                  title: t('products.items.serviceAccount.title'),
                  description: t('products.items.serviceAccount.desc'),
                  href: '/products/service-account-security',
                  icon: 'tabler:robot',
                },
                {
                  title: t('products.items.vault.title'),
                  description: t('products.items.vault.desc'),
                  href: '/products/credential-vault',
                  icon: 'tabler:lock',
                },
              ],
            },
            {
              key: 'access',
              title: t('home.platformAccess'),
              items: [
                {
                  title: t('products.items.pam.title'),
                  description: t('products.items.pam.desc'),
                  href: '/products/privileged-account-manager',
                  icon: 'tabler:lock',
                },
                {
                  title: t('products.items.jit.title'),
                  description: t('products.items.jit.desc'),
                  href: '/products/just-in-time-access',
                  icon: 'tabler:clock',
                },
              ],
            },
            {
              key: 'governance',
              title: t('home.platformGovernance'),
              items: [
                {
                  title: t('products.items.session.title'),
                  description: t('products.items.session.desc'),
                  href: '/products/session-manager',
                  icon: 'tabler:video',
                },
                {
                  title: t('products.items.epm.title'),
                  description: t('products.items.epm.desc'),
                  href: '/products/endpoint-privilege-manager',
                  icon: 'tabler:device-desktop',
                },
              ],
            },
          ].map((group) => (
            <section class:list={['sh-platform-group', `sh-platform-group--${group.key}`]}>
              <h3 class="sh-platform-group__header flex items-center gap-3 rounded-t-2xl px-5 py-4 text-lg font-bold text-heading">
                <span class="sh-platform-group__mark" aria-hidden="true">
                  ✦
                </span>
                {group.title}
              </h3>
              <div class="rounded-b-2xl border border-t-0 border-theme bg-card-surface px-5">
                {group.items.map((item, index) => (
                  <a
                    class:list={[
                      'sh-platform-item group flex gap-4 py-5',
                      { 'border-t border-dashed border-theme': index > 0 },
                    ]}
                    href={localePath(item.href)}
                  >
                    <span class="sh-platform-item__icon flex h-11 w-11 shrink-0 items-center justify-center rounded-full">
                      <Icon name={item.icon} class="h-5 w-5" aria-hidden="true" />
                    </span>
                    <span class="min-w-0">
                      <span class="mb-1 block font-semibold text-heading transition-colors group-hover:text-link">
                        {item.title}
                      </span>
                      <span class="block text-sm leading-relaxed text-muted">{item.description}</span>
                    </span>
                  </a>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========== RESOURCES / INSIGHTS ========== -->
  <InsightsCarousel title={t('home.insightsTagline')} information="" />

  <FAQs
    title={t('home.faqsTagline')}
    subtitle={t('home.faqsTitle')}
    items={[
      {
        title: t('home.faq1Q'),
        description: t('home.faq1A'),
      },
      {
        title: t('home.faq2Q'),
        description: t('home.faq2A'),
      },
      {
        title: t('home.faq3Q'),
        description: t('home.faq3A'),
      },
      {
        title: t('home.faq4Q'),
