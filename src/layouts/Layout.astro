---
import '~/assets/styles/tailwind.css';

import { Font } from 'astro:assets';

import { I18N } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import Intersect from '~/components/common/Intersect.astro';
import { SITE, APP_BLOG } from 'astrowind:config';
import { getEnglishPath, getAlternateLanguageUrls } from '~/i18n/routes';
import { getLocaleConfig } from '~/i18n/config';

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
const language = Astro.currentLocale || I18N.language || 'en';
const localeConfig = getLocaleConfig(language);
const textDirection = localeConfig.dir || I18N.textDirection || 'ltr';
const basePath = (SITE.base ?? '/').replace(/^\/+|\/+$/g, '');
const pathname = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const routePath =
  basePath && (pathname === basePath || pathname.startsWith(`${basePath}/`))
    ? pathname.slice(basePath.length)
    : pathname;
const englishPath = getEnglishPath(`/${routePath}`, language);
const searchSection = englishPath.split('/').filter(Boolean)[0] || 'home';
const isLocalizedBlogPost =
  language !== 'en' && englishPath.startsWith(`/${APP_BLOG.list.pathname.replace(/^\/+|\/+$/g, '')}/`);
const alternateLinks =
  metadata.alternateLinks ??
  getAlternateLanguageUrls(englishPath, SITE.site, isLocalizedBlogPost ? [language] : undefined);
---

<!doctype html>
<html lang={localeConfig.htmlLang} dir={textDirection} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <meta data-pagefind-filter="section[content]" content={searchSection} />
    <Favicons />
    <Font cssVariable="--font-inter" preload />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    {alternateLinks.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.url} />)}
    <SiteVerification />
    <Analytics />

    <link rel="preconnect" href="https://images.unsplash.com" />

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />

    <!-- Extra head content from pages: structured data, rel=prev/next, … -->
    <slot name="head" />
  </head>

  <body
    class="antialiased text-default bg-page tracking-tight min-h-screen flex flex-col"
    data-pagefind-body
    data-pagefind-filter={`lang:${localeConfig.code}`}
    data-search-section={searchSection}
  >
    <slot />

    <Intersect />
  </body>
</html>
