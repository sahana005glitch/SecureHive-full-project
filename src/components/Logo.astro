---
import { SITE } from 'astrowind:config';
---

<span class="flex items-center gap-2 self-center ml-2 rtl:ml-0 rtl:mr-2 whitespace-nowrap">
  <!-- SecureHive mark: stylized shield + hive geometry -->
  <svg
    class="h-8 w-8 shrink-0"
    viewBox="0 0 40 40"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <!-- Shield outline -->
    <path
      d="M20 3L6 9v9c0 8.5 5.5 14.5 14 16.5 8.5-2 14-8 14-16.5V9L20 3z"
      fill="#0B2D5B"
      stroke="#0B2D5B"
      stroke-width="1.5"
      stroke-linejoin="round"
    />
    <!-- Inner hex / hive cell -->
    <path
      d="M20 12l5.5 3.2v6.4L20 24.8l-5.5-3.2v-6.4L20 12z"
      fill="none"
      stroke="#3B82F6"
      stroke-width="1.6"
      stroke-linejoin="round"
    />
    <!-- Center node -->
    <circle cx="20" cy="18.5" r="2.2" fill="#3B82F6" />
    <!-- Connection dots -->
    <circle cx="14.5" cy="15.2" r="1.1" fill="#60A5FA" opacity="0.9" />
    <circle cx="25.5" cy="15.2" r="1.1" fill="#60A5FA" opacity="0.9" />
    <circle cx="14.5" cy="21.8" r="1.1" fill="#60A5FA" opacity="0.9" />
    <circle cx="25.5" cy="21.8" r="1.1" fill="#60A5FA" opacity="0.9" />
  </svg>
  <span class="text-xl md:text-lg font-bold text-[#0B2D5B] dark:text-white tracking-tight">
    {SITE?.name}
  </span>
</span>
