---
import { getLocalizedTaxonomyPath } from '~/i18n/routes';

import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

export interface Props {
  tags: Post['tags'];
  class?: string;
  title?: string | undefined;
  isCategory?: boolean;
}

const { tags, class: className = 'text-sm', title = undefined, isCategory = false } = Astro.props;
const locale = Astro.currentLocale || 'en';
---

{
  tags && Array.isArray(tags) && (
    <>
      {title !== undefined && (
        <span class="align-super font-normal underline underline-offset-4 decoration-2 dark:text-muted">{title}</span>
      )}
      <ul class={className}>
        {tags.map((tag) => (
          <li class="bg-gray-100 dark:bg-card-surface inline-block mr-2 rtl:mr-0 rtl:ml-2 mb-2 py-0.5 px-2 lowercase font-medium">
            {!APP_BLOG?.tag?.isEnabled ? (
              tag.title
            ) : (
              <a
                href={getLocalizedTaxonomyPath(isCategory ? 'category' : 'tag', tag.slug, locale)}
                class="text-muted dark:text-default hover:text-primary dark:hover:text-heading"
              >
                {tag.title}
              </a>
            )}
          </li>
        ))}
      </ul>
    </>
  )
}
