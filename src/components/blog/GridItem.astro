---
import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import Image from '~/components/common/Image.astro';

import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';

//Unlike Grid.astro, which receives an array, this component receives a single post object.
export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = await findImage(post.image);

//It determines whether the post is clickable
//If blog post routes are enabled, the component creates a link.
//Otherwise, it uses an empty string and displays the title and image without linking them to a post page.


const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

<article
  class="mb-6 transition intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
>
  <div class="relative md:h-64 bg-gray-400 dark:bg-card-surface rounded shadow-lg mb-6">
    {
      image &&
        (link ? (
          <a href={link}>
            <Image
              src={image}
              class="w-full md:h-full object-cover rounded shadow-lg bg-gray-400 dark:bg-card-surface"
              widths={[400, 900]}
              width={900}
              height={506}
              sizes="(max-width: 900px) 400px, 900px"
              alt={post.title}
              format="webp"
              loading="lazy"
              decoding="async"
            />
          </a>
        ) : (
          <Image
            src={image}
            class="w-full md:h-full object-cover rounded shadow-lg bg-gray-400 dark:bg-card-surface"
            widths={[400, 900]}
            width={900}
            height={506}
            sizes="(max-width: 900px) 400px, 900px"
            alt={post.title}
            format="webp"
            loading="lazy"
            decoding="async"
          />
        ))
    }
  </div>

  <h3 class="text-xl sm:text-2xl font-bold leading-tight mb-2 font-heading dark:text-heading">

<!-- The visitor sees the post title and a short description. When linking is enabled, clicking the title opens the article. -->
    {
      link ? (
        <a class="inline-block hover:text-primary dark:hover:text-link transition ease-in duration-200" href={link}>
          {post.title}
        </a>
      ) : (
        post.title
      )
    }
  </h3>

  <p class="text-muted dark:text-muted text-lg">{post.excerpt}</p>
</article>
